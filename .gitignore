# Git Ignore Rules for FClinic Monorepo

# Local reports and test directories/files
/Report/
**/src/test/
**/test/
**/tests/
**/__tests__/
**/*.test.*
**/*.spec.*
**/__pycache__/
*.pyc


# Compiled class and jar files
**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Node / Frontend
**/node_modules/
**/dist/
**/build/
.npm
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
**/.env
**/.env.*
!**/.env.example

# IDEs and Editors
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs
**/logs/
*.log
/.runtime/

# Docker volume mounts (local)
pgdata/
redisdata/


### Personal gitignore files
AGENTS.md
CLAUDE.md

# Keep reviewed Notification security/recipient regression tests in source control.
!ClinicAppointmentBE/services/notification-service/src/test/
!ClinicAppointmentBE/services/notification-service/src/test/**
!ClinicAppointmentFE/src/notification/__tests__/
!ClinicAppointmentFE/src/notification/__tests__/**

# Keep the booking/onboarding regression coverage introduced with this flow.
!ClinicAppointmentBE/services/auth-service/src/test/
ClinicAppointmentBE/services/auth-service/src/test/**
!ClinicAppointmentBE/services/auth-service/src/test/**/
!ClinicAppointmentBE/services/auth-service/src/test/**/PatientOnboarding*Test.java
!ClinicAppointmentBE/services/auth-service/src/test/**/HttpPatientProvisioningAdapterTest.java
!ClinicAppointmentBE/services/patient-service/src/test/
ClinicAppointmentBE/services/patient-service/src/test/**
!ClinicAppointmentBE/services/patient-service/src/test/**/
!ClinicAppointmentBE/services/patient-service/src/test/**/PatientOnboardingHttpTest.java
!ClinicAppointmentBE/services/doctor-service/src/test/
ClinicAppointmentBE/services/doctor-service/src/test/**
!ClinicAppointmentBE/services/doctor-service/src/test/**/
!ClinicAppointmentBE/services/doctor-service/src/test/**/DoctorBookingValidationHttpTest.java
!ClinicAppointmentFE/src/appointment/__tests__/
ClinicAppointmentFE/src/appointment/__tests__/*
!ClinicAppointmentFE/src/appointment/__tests__/doctor-schedule.test.jsx
