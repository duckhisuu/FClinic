# Git Ignore Rules for FClinic Monorepo

# Local reports and test directories/files
/Report/
**/src/test/
**/test/
**/tests/
**/__tests__/
**/*.test.*
**/*.spec.*
**/__pycache__/
*.pyc


# Compiled class and jar files
**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Node / Frontend
**/node_modules/
**/dist/
**/build/
.npm
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
**/.env
**/.env.*
!**/.env.example

# IDEs and Editors
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs
**/logs/
*.log
/.runtime/

# Docker volume mounts (local)
pgdata/
redisdata/


### Personal gitignore files
AGENTS.md
CLAUDE.md

# Keep reviewed Notification security/recipient regression tests in source control.
!ClinicAppointmentBE/services/notification-service/src/test/
!ClinicAppointmentBE/services/notification-service/src/test/**
!ClinicAppointmentFE/src/notification/__tests__/
!ClinicAppointmentFE/src/notification/__tests__/**

# Keep self-service profile regression coverage in source control.
!ClinicAppointmentBE/services/auth-service/src/test/
!ClinicAppointmentBE/services/auth-service/src/test/**
!ClinicAppointmentFE/src/patient/__tests__/
!ClinicAppointmentFE/src/patient/__tests__/self-profile.test.jsx
!ClinicAppointmentFE/src/patient/__tests__/patient-access.test.jsx

# Keep booking profile recovery regression coverage in source control.
!ClinicAppointmentFE/src/appointment/__tests__/
!ClinicAppointmentFE/src/appointment/__tests__/patient-selection.test.jsx
