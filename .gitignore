# Git Ignore Rules for FClinic Monorepo

# Local reports and tests (keep these ignored after running tests)
/Report/
**/test/
**/tests/
**/__tests__/

# Security regression tests belong to the source changes below.
!/ClinicAppointmentBE/services/appointment-service/src/test/
/ClinicAppointmentBE/services/appointment-service/src/test/*
!/ClinicAppointmentBE/services/appointment-service/src/test/java/
!/ClinicAppointmentBE/services/auth-service/src/test/
/ClinicAppointmentBE/services/auth-service/src/test/*
!/ClinicAppointmentBE/services/auth-service/src/test/java/
!/ClinicAppointmentBE/infra/api-gateway/src/test/
/ClinicAppointmentBE/infra/api-gateway/src/test/*
!/ClinicAppointmentBE/infra/api-gateway/src/test/java/
!/ClinicAppointmentBE/services/notification-service/src/test/
/ClinicAppointmentBE/services/notification-service/src/test/*
!/ClinicAppointmentBE/services/notification-service/src/test/java/
!/ClinicAppointmentFE/src/notification/__tests__/

# Compiled class and jar files
**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Node / Frontend
**/node_modules/
**/dist/
**/build/
.npm
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
**/.env
**/.env.*
!**/.env.example

# IDEs and Editors
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs
**/logs/
*.log

# Docker volume mounts (local)
pgdata/
redisdata/


### Personal gitignore files
AGENTS.md
CLAUDE.md
