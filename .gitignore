# Git Ignore Rules for FClinic Monorepo

# Compiled class and jar files
**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Node / Frontend
**/node_modules/
**/dist/
**/build/
.npm
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# IDEs and Editors
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs
**/logs/
*.log

# Docker volume mounts (local)
pgdata/
redisdata/


### Personal gitignore files
AGENTS.md
CLAUDE.md
