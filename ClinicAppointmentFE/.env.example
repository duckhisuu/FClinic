# Development: Vite forwards every /api request to the API Gateway.
VITE_PROXY_TARGET=http://localhost:8080

# Leave empty to use same-origin /api (Vite proxy in development;
# configure the deployment reverse proxy to forward /api to the gateway).
# For a separate gateway origin, set its URL at build time, without /api.
# Never use an individual service URL here.
VITE_API_GATEWAY_URL=
