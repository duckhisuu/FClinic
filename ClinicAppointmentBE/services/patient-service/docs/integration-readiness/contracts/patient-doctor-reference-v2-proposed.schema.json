        "message": {
          "type": "string",
          "maxLength": 8192
        },
        "data": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "name": {
              "type": "string",
              "maxLength": 8192
            },
            "specialty": {
              "type": "string",
              "maxLength": 8192
            },
            "department": {
              "type": "string",
              "maxLength": 8192
            },
            "qualification": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8192
            },
            "experienceYears": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "consultationFee": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "roomNumber": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8192
            },
            "bio": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8192
            },
            "avatarUrl": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8192
            },
            "active": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "name",
            "specialty",
            "department",
            "qualification",
            "experienceYears",
            "consultationFee",
            "roomNumber",
            "bio",
            "avatarUrl",
            "active"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "message",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "const": 404
        },
        "message": {
          "type": "string",
          "maxLength": 8192
        },
        "data": {
          "type": "null"
        },
        "code": {
          "const": "DOCTOR_NOT_FOUND"
        },
        "fieldErrors": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "status",
        "message",
        "data",
        "code",
        "fieldErrors"
      ],
      "additionalProperties": false
    }
