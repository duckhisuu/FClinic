{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fclinic:patient:proposed:patient-doctor-reference-v2-proposed.schema",
  "title": "PROPOSED HTTP loopback / UUIDv4 reference v2 \u2014 owner approval pending",
  "x-http": {
    "method": "GET",
    "candidate": "/api/v1/doctors/{id}",
    "requiredResponseHeader": {
      "X-FClinic-Reference-Contract": "patient-doctor-reference/2"
    },
    "contentType": "application/json",
    "authentication": "Dedicated backend Basic over loopback HTTP or verified HTTPS; no human bearer"
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "const": 200
