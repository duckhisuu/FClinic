{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fclinic:patient:proposed:patient-identity-introspection:2",
  "title": "PROPOSED patient-identity-introspection/2 UUIDv4 \u2014 authority owner approval pending",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "active": {
          "const": false
        }
      },
      "required": [
        "active"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "active": {
          "const": true
        },
        "contractVersion": {
          "const": "patient-identity-introspection/2"
        },
        "iss": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "aud": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          ]
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sub": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "principalType": {
          "enum": [
            "USER",
            "SERVICE"
          ]
        },
        "userId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "patientId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "doctorId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "authorities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "active",
        "contractVersion",
        "iss",
        "aud",
        "exp",
        "sub",
        "principalType",
        "userId",
        "patientId",
        "doctorId",
        "authorities"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "principalType": {
                "const": "USER"
              }
            }
          },
          "then": {
            "properties": {
              "userId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "authorities": {
                "items": {
                  "enum": [
                    "ROLE_PATIENT",
                    "ROLE_DOCTOR",
                    "ROLE_STAFF",
                    "ROLE_ADMIN"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "principalType": {
                "const": "SERVICE"
              }
            }
          },
          "then": {
            "properties": {
              "userId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "patientId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "doctorId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "authorities": {
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^SVC_[A-Z0-9_]{1,80}$"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
