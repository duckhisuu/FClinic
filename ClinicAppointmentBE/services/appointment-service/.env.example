# Copy to an ignored local env file and supply the credentials for the actual DB/broker.
DB_USERNAME=
DB_PASSWORD=
APPOINTMENT_DB_NAME=appointment_db
APPOINTMENT_DB_HOST=postgres-appointment
APPOINTMENT_HTTP_PORT=8083
APPOINTMENT_DOCKER_NETWORK=clinicappointmentbe_fclinic-network
APPOINTMENT_PATIENT_URL=https://patient-service:8081
APPOINTMENT_DOCTOR_URL=https://doctor-service:8082
APPOINTMENT_SERVICE_TOKEN=
APPOINTMENT_RECIPIENT_URL=https://auth-service:8085/api/v1/auth/internal/appointment-recipient-accounts
APPOINTMENT_OUTBOX_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
EUREKA_ENABLED=false
EUREKA_SERVER_URL=http://discovery-server:8761/eureka/

# Docker DNS endpoints require valid TLS certificates. Supply all secrets externally,
# with matching client credentials in Auth, Doctor, Patient and Notification.
APPOINTMENT_AUTH_INTROSPECTION_URI=https://auth-service:8085/api/v1/auth/introspect
APPOINTMENT_AUTH_CLIENT_ID=appointment-introspection
APPOINTMENT_AUTH_CLIENT_SECRET=
APPOINTMENT_SCOPE_URI=https://auth-service:8085/api/v1/auth/scopes
APPOINTMENT_SCOPE_CLIENT_ID=appointment-scope
APPOINTMENT_SCOPE_CLIENT_SECRET=
KEYCLOAK_ISSUER_URI=https://identity.example.test/realms/fclinic
APPOINTMENT_PATIENT_TOKEN_URI=https://identity.example.test/realms/fclinic/protocol/openid-connect/token
APPOINTMENT_PATIENT_TOKEN_CLIENT_ID=appointment-service
APPOINTMENT_PATIENT_TOKEN_CLIENT_SECRET=
PATIENT_APPOINTMENT_REFERENCE_CLIENT_ID=patient-appointment-reference
PATIENT_APPOINTMENT_REFERENCE_CLIENT_SECRET=
APPOINTMENT_NOTIFICATION_REFERENCE_CLIENT_ID=notification-appointment-reference
APPOINTMENT_NOTIFICATION_REFERENCE_CLIENT_SECRET=
APPOINTMENT_DOCTOR_CLIENT_ID=appointment-doctor-reference
APPOINTMENT_DOCTOR_CLIENT_SECRET=
APPOINTMENT_RECIPIENT_CLIENT_ID=appointment-recipient-accounts
APPOINTMENT_RECIPIENT_CLIENT_SECRET=
# Optional docker-compose.tls.yml mount, containing application.yml and PKCS12 files.
APPOINTMENT_TLS_DIRECTORY=
APPOINTMENT_TRUST_STORE=
APPOINTMENT_TRUST_STORE_PASSWORD=