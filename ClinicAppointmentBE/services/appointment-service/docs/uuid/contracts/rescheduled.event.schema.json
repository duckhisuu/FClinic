{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APPOINTMENT_RESCHEDULED — UUID lifecycle event v3",
  "x-contract-status": "PROPOSED_SHARED_TARGET",
  "x-decision-ids": [
    "D-01",
    "D-08",
    "D-09",
    "D-11"
  ],
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "eventType": {
      "type": "string",
      "const": "APPOINTMENT_RESCHEDULED"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 3
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "source": {
      "const": "appointment-service",
      "type": "string"
    },
    "appointmentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "format": "int64"
    },
    "bookingCode": {
      "type": "string"
    },
    "patientId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "patientName": {
      "type": "string"
    },
    "patientPhone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$"
    },
    "doctorId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "doctorName": {
      "type": "string"
    },
    "doctorSpecialty": {
      "type": "string"
    },
    "slotId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "appointmentDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "startTime": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"
    },
    "endTime": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"
    },
    "timezone": {
      "const": "Asia/Saigon",
      "type": "string"
    },
    "recipients": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "recipientType": {
            "type": "string",
            "enum": [
              "PATIENT",
              "DOCTOR"
            ]
          },
          "userId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email",
                "maxLength": 320
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "recipientType",
          "userId",
          "name",
          "email"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "recipientType": {
                  "const": "DOCTOR"
                }
              }
            },
            "then": {
              "properties": {
                "userId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "recipientType": {
                "const": "PATIENT"
              }
            },
            "required": [
              "recipientType"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "recipientType": {
                "const": "DOCTOR"
              }
            },
            "required": [
              "recipientType"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "previousSlotId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "previousAppointmentDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "previousStartTime": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"
    },
    "previousEndTime": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "source",
    "appointmentId",
    "aggregateVersion",
    "bookingCode",
    "patientId",
    "patientName",
    "patientPhone",
    "doctorId",
    "doctorName",
    "doctorSpecialty",
    "slotId",
    "appointmentDate",
    "startTime",
    "endTime",
    "timezone",
    "recipients",
    "previousSlotId",
    "previousAppointmentDate",
    "previousStartTime",
    "previousEndTime"
  ],
  "additionalProperties": false,
  "$id": "urn:fclinic:appointment:rescheduled:3"
}
