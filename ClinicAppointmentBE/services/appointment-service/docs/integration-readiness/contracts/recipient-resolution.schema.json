{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D-08 configurable adapter proposal, not an existing Auth endpoint",
  "x-contract-status": "APPOINTMENT_ADAPTER_PROPOSAL_REQUIRES_PROVIDER_AGREEMENT",
  "type": "object",
  "properties": {
    "status": {
      "const": 200
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "recipientType": {
            "type": "string",
            "enum": [
              "PATIENT",
              "DOCTOR"
            ]
          },
          "userId": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "format": "int64"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email",
                "maxLength": 320
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "recipientType",
          "userId",
          "name",
          "email"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "recipientType": {
                  "const": "DOCTOR"
                }
              }
            },
            "then": {
              "properties": {
                "userId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "format": "int64"
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "recipientType": {
                "const": "PATIENT"
              }
            },
            "required": [
              "recipientType"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "recipientType": {
                "const": "DOCTOR"
              }
            },
            "required": [
              "recipientType"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "required": [
    "status",
    "message",
    "data"
  ],
  "additionalProperties": false
}
