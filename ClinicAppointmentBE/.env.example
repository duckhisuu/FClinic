# ==============================================================================
# FClinic Microservices Environment Configuration
# ==============================================================================

# PostgreSQL Credentials (Database-per-service pattern)
DB_USERNAME=fclinic_admin
DB_PASSWORD=fclinic_secret

# Database Names
PATIENT_DB_NAME=patient_db
DOCTOR_DB_NAME=doctor_db
APPOINTMENT_DB_NAME=appointment_db
NOTIFICATION_DB_NAME=notification_db

# PostgreSQL Host Port Mappings
POSTGRES_PATIENT_PORT=5433
POSTGRES_DOCTOR_PORT=5434
POSTGRES_APPOINTMENT_PORT=5435
POSTGRES_NOTIFICATION_PORT=5436

# Redis Configuration (Distributed Lock)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Configuration (Event Notification Broker)
RABBITMQ_DEFAULT_USER=fclinic_rabbit
RABBITMQ_DEFAULT_PASS=rabbit_secret
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Spring Cloud Eureka Discovery Server
EUREKA_SERVER_PORT=8761
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# API Gateway Port
API_GATEWAY_PORT=8080

# Microservice Ports
PATIENT_SERVICE_PORT=8081
DOCTOR_SERVICE_PORT=8082
APPOINTMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# Notification Service - SMTP (MailHog locally; UI at http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@fclinic.local
MAIL_FROM_NAME=FClinic
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
