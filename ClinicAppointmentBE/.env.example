# ==============================================================================
# FClinic Microservices Environment Configuration
# ==============================================================================

# PostgreSQL Credentials (Database-per-service pattern)
DB_HOST=localhost
DB_USERNAME=fclinic_admin
DB_PASSWORD=fclinic_secret

# Database Names
AUTH_DB_NAME=auth_db
KEYCLOAK_DB_NAME=keycloak_db
PATIENT_DB_NAME=patient_db
DOCTOR_DB_NAME=doctor_db
APPOINTMENT_DB_NAME=appointment_db
NOTIFICATION_DB_NAME=notification_db

# PostgreSQL Host Port Mappings
POSTGRES_AUTH_PORT=5438
POSTGRES_KEYCLOAK_PORT=5439
POSTGRES_PATIENT_PORT=5443
POSTGRES_DOCTOR_PORT=5434
POSTGRES_APPOINTMENT_PORT=5435
POSTGRES_NOTIFICATION_PORT=5436

# Patient v2 requires an explicitly selected and prepared database.
PATIENT_V2_DB_URL=jdbc:postgresql://${DB_HOST}:${POSTGRES_PATIENT_PORT}/${PATIENT_DB_NAME}
PATIENT_V2_DB_USERNAME=${DB_USERNAME}
PATIENT_V2_DB_PASSWORD=${DB_PASSWORD}

# Redis Configuration (Distributed Lock)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Configuration (Event Notification Broker)
RABBITMQ_DEFAULT_USER=fclinic_rabbit
RABBITMQ_DEFAULT_PASS=rabbit_secret
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Spring Cloud Eureka Discovery Server
EUREKA_SERVER_PORT=8761
EUREKA_SERVER_URL=http://localhost:8761/eureka/
# Required for Gateway lb:// routes. Individual isolated tests override discovery explicitly.
EUREKA_ENABLED=true

# API Gateway Port
API_GATEWAY_PORT=8080

# Microservice Ports
AUTH_SERVICE_PORT=8085
PATIENT_SERVICE_PORT=8081
DOCTOR_SERVICE_PORT=8082
APPOINTMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# Keycloak Identity Provider & Auth Service Configuration
KEYCLOAK_PORT=8180
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=fclinic
KEYCLOAK_CLIENT_ID=fclinic-auth-service
KEYCLOAK_CLIENT_SECRET=fclinic-auth-secret-dev
KEYCLOAK_WEB_CLIENT_ID=fclinic-web
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
AUTH_INTROSPECTION_CLIENT_ID=patient-service
AUTH_INTROSPECTION_CLIENT_SECRET=patient-introspection-secret-dev
AUTH_INTROSPECTION_ISSUER=http://localhost:8180/realms/fclinic
AUTH_OTP_EXPOSE_IN_RESPONSE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notification Service - SMTP (MailHog locally; UI at http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@fclinic.local
MAIL_FROM_NAME=FClinic
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Appointment v2: existing provider credentials, recipient endpoint and reminder policy.
APPOINTMENT_SERVICE_TOKEN=
APPOINTMENT_RECIPIENT_URL=
APPOINTMENT_REMINDER_LEAD=
APPOINTMENT_PATIENT_URL=http://localhost:8081
APPOINTMENT_DOCTOR_URL=http://localhost:8082
APPOINTMENT_OUTBOX_ENABLED=true

# Appointment/Auth/Patient integration (supply distinct secrets externally; no generated defaults).
APPOINTMENT_AUTH_INTROSPECTION_URI=https://localhost:8085/api/v1/auth/introspect
APPOINTMENT_AUTH_CLIENT_ID=appointment-introspection
APPOINTMENT_AUTH_CLIENT_SECRET=
APPOINTMENT_SCOPE_URI=https://localhost:8085/api/v1/auth/scopes
APPOINTMENT_SCOPE_CLIENT_ID=appointment-scope
APPOINTMENT_SCOPE_CLIENT_SECRET=
APPOINTMENT_SERVICE_SUBJECT=22222222-2222-4222-8222-222222222205
APPOINTMENT_PATIENT_TOKEN_URI=http://localhost:8180/realms/fclinic/protocol/openid-connect/token
APPOINTMENT_PATIENT_TOKEN_CLIENT_ID=appointment-service
APPOINTMENT_PATIENT_TOKEN_CLIENT_SECRET=

# Activate Patient with --spring.profiles.active=service-integration,local after preparing its UUID DB.
PATIENT_UUID_DB_URL=jdbc:postgresql://localhost:5443/patient_uuid
PATIENT_UUID_DB_USERNAME=${DB_USERNAME}
PATIENT_UUID_DB_PASSWORD=${DB_PASSWORD}
PATIENT_AUTH_INTROSPECTION_URI=https://localhost:8085/api/v1/auth/introspect
PATIENT_AUTH_ISSUER=http://localhost:8180/realms/fclinic
PATIENT_AUTH_CLIENT_ID=patient-service
PATIENT_AUTH_CLIENT_SECRET=${AUTH_INTROSPECTION_CLIENT_SECRET}
PATIENT_ADMIN_SCOPE_URI=https://localhost:8085/api/v1/auth/scopes
PATIENT_ADMIN_SCOPE_CLIENT_ID=patient-admin-scope
PATIENT_ADMIN_SCOPE_CLIENT_SECRET=
PATIENT_CLINICAL_SCOPE_URI=https://localhost:8085/api/v1/auth/scopes
PATIENT_CLINICAL_SCOPE_CLIENT_ID=patient-clinical-scope
PATIENT_CLINICAL_SCOPE_CLIENT_SECRET=
PATIENT_APPOINTMENT_REFERENCE_URI=http://localhost:8083/api/v2/appointments
PATIENT_APPOINTMENT_REFERENCE_CLIENT_ID=patient-appointment-reference
PATIENT_APPOINTMENT_REFERENCE_CLIENT_SECRET=
APPOINTMENT_NOTIFICATION_REFERENCE_CLIENT_ID=notification-appointment-reference
APPOINTMENT_NOTIFICATION_REFERENCE_CLIENT_SECRET=
# Auth must be served with TLS for the Patient identity/scope clients (SERVER_SSL_* or trusted TLS proxy).
# Use protected external YAML for TLS trust stores and staff/doctor assignments; see Appointment security runbook.
